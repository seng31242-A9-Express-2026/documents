        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml\n\nLAYOUT_WITH_LEGEND()\n\ntitle C4 Model - Level 3: Component Diagram\\nA9 Express - Booking Service (Internal Components)\n\nContainer(api_gateway, \&quot;API Gateway\&quot;, \&quot;Gateway/Middleware\&quot;)\n\nContainer_Boundary(booking_service, \&quot;Booking Service Boundary (Node.js/Express.js)\&quot;) {\n    Component(auth_middleware, \&quot;Auth Middleware\&quot;, \&quot;Component\&quot;, \&quot;JWT verification &amp; RBAC enforcement\&quot;)\n    Component(booking_controller, \&quot;Booking Controller\&quot;, \&quot;Component\&quot;, \&quot;Orchestrates booking lifecycle\&quot;)\n    \n    Component(route_manager, \&quot;Route Manager\&quot;, \&quot;Component\&quot;, \&quot;Search &amp; schedule lookup\&quot;)\n    Component(seat_manager, \&quot;Seat Manager\&quot;, \&quot;Component\&quot;, \&quot;15 min-hold &amp; seat locking\&quot;)\n    Component(tour_manager, \&quot;Tour Package Manager\&quot;, \&quot;Component\&quot;, \&quot;Pricing &amp; itinerary calc\&quot;)\n    Component(schedule_manager, \&quot;Schedule Manager\&quot;, \&quot;Component\&quot;, \&quot;Availability &amp; conflicts\&quot;)\n    \n    Component(booking_repository, \&quot;Booking Repository\&quot;, \&quot;Component\&quot;, \&quot;All DB read/write (ORM)\&quot;)\n    Component(notification_bridge, \&quot;Notification Bridge\&quot;, \&quot;Component\&quot;, \&quot;Publish to notification queue\&quot;)\n}\n\nSystem_Ext(google_maps, \&quot;Google Maps\&quot;, \&quot;Distance API\&quot;)\nContainerDb(mysql_rds, \&quot;MySQL RDS\&quot;, \&quot;AWS RDS\&quot;)\nContainer(notif_queue, \&quot;Notif. Queue\&quot;, \&quot;Redis PubSub\&quot;)\n\nRel(api_gateway, auth_middleware, \&quot;HTTP Request\&quot;)\nRel(auth_middleware, booking_controller, \&quot;Verified request\&quot;)\n\nRel(booking_controller, route_manager, \&quot;Route query\&quot;)\nRel(booking_controller, seat_manager, \&quot;Reserve seats\&quot;)\nRel(booking_controller, tour_manager, \&quot;Tour calc\&quot;)\nRel(booking_controller, schedule_manager, \&quot;Schedule check\&quot;)\n\nRel(route_manager, booking_repository, \&quot;SQL\&quot;)\nRel(seat_manager, booking_repository, \&quot;SQL\&quot;)\nRel(tour_manager, booking_repository, \&quot;SQL\&quot;)\nRel(schedule_manager, booking_repository, \&quot;SQL\&quot;)\n\nRel(booking_repository, google_maps, \&quot;Distance queries\&quot;)\nRel(booking_repository, mysql_rds, \&quot;Queries\&quot;)\n\nRel(schedule_manager, notification_bridge, \&quot;Publish\&quot;)\nRel(notification_bridge, notif_queue, \&quot;Publish\&quot;)\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="ys2E5qoT0TriqABOp-5M-3">
