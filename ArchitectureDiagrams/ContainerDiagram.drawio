        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml\n\nLAYOUT_TOP_DOWN()\nSHOW_LEGEND()\n\ntitle C4 Model - Level 2: Container Diagram\\nA9 Express - Internal Containers\n\nPerson(customer_admin, \&quot;Customer / Admin\&quot;, \&quot;Person\&quot;)\nPerson(driver_operator, \&quot;Driver / Operator\&quot;, \&quot;Person\&quot;)\n\nSystem_Boundary(a9_system, \&quot;A9 Express System Boundary\&quot;) {\n    Container(web_app, \&quot;Web Application\&quot;, \&quot;React.js + Tailwind CSS\&quot;, \&quot;Admin, Operator &amp; Customer portal\&quot;)\n    Container(mobile_app, \&quot;Mobile Application\&quot;, \&quot;React Native\&quot;, \&quot;Customer-facing iOS &amp; Android app\&quot;)\n    \n    Container(api_gateway, \&quot;API Gateway\&quot;, \&quot;Express.js / Node.js\&quot;, \&quot;Auth, routing &amp; rate limiting\&quot;)\n    \n    Container(booking_service, \&quot;Booking Service\&quot;, \&quot;Node.js\&quot;, \&quot;Bus, airport &amp; tour reservations\&quot;)\n    Container(payment_service, \&quot;Payment Service\&quot;, \&quot;Node.js + Stripe SDK\&quot;, \&quot;Payment processing &amp; refunds\&quot;)\n    Container(notification_service, \&quot;Notification Service\&quot;, \&quot;Node.js + SendGrid\&quot;, \&quot;Email, SMS &amp; in-app alerts\&quot;)\n    \n    ContainerDb(mysql_db, \&quot;MySQL 8.0 Database\&quot;, \&quot;AWS RDS - InnoDB\&quot;, \&quot;All booking &amp; business data\&quot;)\n    ContainerDb(redis_cache, \&quot;Redis Cache\&quot;, \&quot;AWS ElastiCache\&quot;, \&quot;Sessions, seat maps &amp; route cache\&quot;)\n    ContainerDb(s3_store, \&quot;S3 Object Store\&quot;, \&quot;AWS S3\&quot;, \&quot;Reports, tickets &amp; static assets\&quot;)\n}\n\nSystem_Ext(stripe_paypal, \&quot;Stripe / PayPal\&quot;, \&quot;External Payment\&quot;)\nSystem_Ext(sendgrid_twilio, \&quot;SendGrid / Twilio\&quot;, \&quot;Email &amp; SMS\&quot;)\nSystem_Ext(google_maps, \&quot;Google Maps API\&quot;, \&quot;Mapping Service\&quot;)\n\nRel(customer_admin, web_app, \&quot;HTTPS\&quot;)\nRel(driver_operator, mobile_app, \&quot;HTTPS\&quot;)\n\nRel(web_app, api_gateway, \&quot;REST/HTTPS\&quot;)\nRel(mobile_app, api_gateway, \&quot;REST/HTTPS\&quot;)\n\nRel(api_gateway, booking_service, \&quot;Delegates\&quot;)\nRel(api_gateway, payment_service, \&quot;Delegates\&quot;)\nRel(api_gateway, notification_service, \&quot;Delegates\&quot;)\n\nRel(booking_service, mysql_db, \&quot;SQL / ORM\&quot;)\nRel(booking_service, redis_cache, \&quot;Cache R/W\&quot;)\nRel(payment_service, redis_cache, \&quot;Cache\&quot;)\nRel(notification_service, s3_store, \&quot;Store/Fetch\&quot;)\n\nRel(mysql_db, stripe_paypal, \&quot;Pay\&quot;)\nRel(redis_cache, sendgrid_twilio, \&quot;Process\&quot;)\nRel(s3_store, google_maps, \&quot;Notify\&quot;)\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="4MY_0mZPFReEgVwI7kB8-1">
