        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\nhide circle\nskinparam linetype ortho\n\nentity \&quot;BusRoute\&quot; {\n  *route_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  origin : VARCHAR(100)\n  destination : VARCHAR(100)\n  stops : TEXT\n  distance_km : DECIMAL(6,2)\n  status : ENUM\n}\n\nentity \&quot;Vehicle\&quot; {\n  *vehicle_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  registration_number : VARCHAR(20)\n  vehicle_type : VARCHAR(50)\n  capacity : INT\n  status : ENUM\n}\n\nentity \&quot;Driver\&quot; {\n  *driver_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  first_name : VARCHAR(100)\n  last_name : VARCHAR(100)\n  license_number : VARCHAR(50)\n  contact_number : VARCHAR(15)\n  status : ENUM\n}\n\nentity \&quot;User\&quot; {\n  *user_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  username : VARCHAR(50)\n  password_hash : VARCHAR(255)\n  role : ENUM\n  email : VARCHAR(150)\n  is_active : BOOLEAN\n  failed_attempts : INT\n  locked_until : DATETIME\n  last_login : DATETIME\n}\n\nentity \&quot;AuditLog\&quot; {\n  *log_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  user_id : INT &lt;&lt;FK&gt;&gt;\n  action_type : VARCHAR(100)\n  entity_type : VARCHAR(100)\n  entity_id : VARCHAR(50)\n  description : TEXT\n  timestamp : DATETIME\n}\n\nentity \&quot;Customer\&quot; {\n  *customer_id : VARCHAR(10) &lt;&lt;PK&gt;&gt;\n  --\n  first_name : VARCHAR(100)\n  last_name : VARCHAR(100)\n  email : VARCHAR(150)\n  phone_number : VARCHAR(15)\n  password_hash : VARCHAR(255)\n  address : TEXT\n  registered_date : DATETIME\n  account_status : ENUM\n}\n\nentity \&quot;TourPackage\&quot; {\n  *package_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  customer_id : VARCHAR(10) &lt;&lt;FK&gt;&gt;\n  destinations : TEXT\n  duration_days : INT\n  vehicle_type : VARCHAR(50)\n  total_price : DECIMAL(10,2)\n  package_status : ENUM\n}\n\nentity \&quot;Schedule\&quot; {\n  *schedule_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  route_id : INT &lt;&lt;FK&gt;&gt;\n  vehicle_id : INT &lt;&lt;FK&gt;&gt;\n  driver_id : INT &lt;&lt;FK&gt;&gt;\n  departure_time : DATETIME\n  arrival_time : DATETIME\n  seat_capacity : INT\n}\n\nentity \&quot;Booking\&quot; {\n  *booking_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  customer_id : VARCHAR(10) &lt;&lt;FK&gt;&gt;\n  schedule_id : INT &lt;&lt;FK&gt;&gt;\n  booking_date : DATETIME\n  total_amount : DECIMAL(10,2)\n  booking_status : ENUM\n  payment_status : ENUM\n}\n\nentity \&quot;Seat\&quot; {\n  *seat_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  schedule_id : INT &lt;&lt;FK&gt;&gt;\n  booking_id : INT &lt;&lt;FK&gt;&gt;\n  seat_number : VARCHAR(10)\n  seat_status : ENUM\n}\n\n&#39; Relationships\nBusRoute ||--o{ Schedule : \&quot;contains\&quot;\nVehicle ||--o{ Schedule : \&quot;assigned_to\&quot;\nDriver ||--o{ Schedule : \&quot;drives\&quot;\nCustomer ||--o{ TourPackage : \&quot;creates\&quot;\nCustomer ||--o{ Booking : \&quot;makes\&quot;\nSchedule ||--o{ Booking : \&quot;has\&quot;\nSchedule ||--o{ Seat : \&quot;contains\&quot;\nBooking ||--o{ Seat : \&quot;reserves\&quot;\nUser ||--o{ AuditLog : \&quot;records\&quot;\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="vW4SMNOTGFk4OqKPWT2x-1">
